---
import Base from '../layouts/Base.astro';
import {topics,informationFeeArticleIds} from '../data/site';
import {publishedArticles,articleUrl} from '../lib/content';
import ArticleCard from '../components/ArticleCard.astro';
import ContactCard from '../components/ContactCard.astro';
const articles=await publishedArticles();
const picks=['cashout-costs','play-balance','refund-request'];
const series=informationFeeArticleIds.map(id=>articles.find(a=>a.id===id)).filter((a):a is NonNullable<typeof a>=>!!a);
---
<Base title="정보이용료현금화 가이드: 수수료·한도·청구·거래 확인" description="정보이용료현금화의 뜻, 수수료와 최종 수령액, 회선 한도, 청구일, 거래 상대와 선입금 요구를 확인하는 가이드. 공식 근거와 상황별 글을 제공합니다.">
 <section class="hero"><div><p class="eyebrow">콘텐츠 결제, 판단의 기준부터</p><h1>정보이용료현금화,<br/><em>결제의 구조</em>부터<br/>확인하세요.</h1><p class="lede">정보이용료와 콘텐츠이용료, Google Play 잔액은 어떻게 다를까요? 비용과 청구 책임, 공식 환불 경로를 차례로 살펴봅니다.</p><div class="hero-actions"><a class="button" href="/information-fee/">정보이용료현금화 가이드 <span aria-hidden="true">→</span></a><a class="text-link" href="/articles/">전체 글 {articles.length}개 ↗</a></div><p class="hero-note">‘컨텐츠이용료현금화’는 ‘콘텐츠이용료현금화’와 함께 안내합니다.</p></div><aside class="field-note"><p class="eyebrow">BEFORE YOU DECIDE</p><h2>진행하기 전, 세 가지 확인</h2><div class="note-step"><span>01</span><div><strong>누가 결제하고 청구받나요?</strong><p class="small">구매 대금과 입금액은 다른 금액입니다.</p></div></div><div class="note-step"><span>02</span><div><strong>공식 환불 대상인가요?</strong><p class="small">거래 제안과 공식 환불을 구분하세요.</p></div></div><div class="note-step"><span>03</span><div><strong>계정 정보를 요구하나요?</strong><p class="small">비밀번호와 인증번호를 전달하지 마세요.</p></div></div><a href="/articles/account-protection/">계정 보호 체크리스트 ↗</a></aside></section>
 <div class="strip"><span>공식 도움말에 기반한 확인 경로</span><span>본문은 정적 HTML로 제공</span><span>자료 확인일은 각 글에서 확인</span></div>
 <section class="section"><div class="section-head"><h2>지금 필요한 정보부터</h2><a href="/topics/">주제 전체 보기 ↗</a></div><div class="route-grid">{topics.map(t=><a class="route-card" href={`/topics/${t.id}/`}><span class="num">{t.number} / TOPIC</span><h3>{t.name}</h3><p>{t.description}</p><span class="arrow" aria-hidden="true">↗</span></a>)}</div></section>
 <section class="section"><div class="featured"><div class="guide-feature"><div><p class="eyebrow">START HERE · 핵심 가이드</p><h2>정보이용료현금화,<br/>무엇을 확인해야 할까요?</h2><p>용어에 대한 이해부터 비용 확인, 환불 가능 여부와 계정 보호까지. 검색 결과를 읽기 전 기준을 세워 보세요.</p></div><a href="/guide/">가이드에서 순서대로 확인하기 →</a></div><div class="featured-links">{picks.map(id=>{const a=articles.find(a=>a.id===id)!;return <a href={articleUrl(a.id)}><div><strong>{a.data.title}</strong><small>{a.data.description}</small></div><span aria-hidden="true">↗</span></a>})}</div></div></section>
 <section class="section"><div class="section-head"><h2>결제 상황별 확인 가이드</h2><a href="/articles/">전체 글 보기 ↗</a></div><div class="articles-grid">{articles.filter(a=>!picks.includes(a.id)).slice(0,6).map((article,index)=><ArticleCard article={article} index={index}/>)}</div></section>
 <ContactCard/>
 <section class="section"><div class="section-head"><h2>정보이용료현금화 집중 가이드 {series.length}편</h2><a href="/information-fee/">확인 순서와 전체 목록</a></div><div class="articles-grid">{series.map((article,index)=><ArticleCard article={article} index={index}/>)}</div></section>
</Base>
