---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import {topics} from '../../data/site';
import {publishedArticles} from '../../lib/content';
export function getStaticPaths(){return topics.map(topic=>({params:{topic:topic.id},props:{topic}}));}
const {topic}=Astro.props;
const articles=(await publishedArticles()).filter(a=>a.data.topic===topic.id);
const routes:Record<string,{intro:string;steps:{id:string;label:string}[]}>= {
 basics:{intro:'정보이용료현금화와 콘텐츠이용료현금화는 같은 검색 의도로 묶었습니다. 실제 결제 수단, 외부 거래 조건, 공식 환불을 나누어 확인하면 광고의 비율과 실제 부담을 혼동하지 않을 수 있습니다.',steps:[{id:'cashout-meaning',label:'검색 표현과 결제·거래·환불의 차이 확인'},{id:'cashout-costs',label:'청구액과 최종 수령액을 가상 예시로 비교'},{id:'carrier-payment',label:'휴대전화 결제의 회선 조건과 제한 확인'}]},
 'google-play':{intro:'구글현금화라는 표현만으로 Play 잔액, 구매 환불, 정기 결제 취소를 같은 절차로 볼 수 없습니다. 현재 가진 것이 잔액인지, 이미 구매한 주문인지, 다음에 청구될 구독인지 먼저 구분하세요.',steps:[{id:'play-balance',label:'잔액의 사용 범위와 반환 제한 확인'},{id:'purchase-history',label:'주문번호와 실제 청구 내역 대조'},{id:'subscription-cancel',label:'다음 정기 결제를 중단하는 절차 확인'}]},
 troubleshooting:{intro:'구매를 취소하고 싶은 경우와 결제한 상품이 제공되지 않은 경우는 확인할 기록과 문의 대상이 다릅니다. 요청 접수, 승인 결정, 결제 수단 반영을 따로 기록하세요.',steps:[{id:'refund-request',label:'특정 주문의 환불 요청과 처리 상태 확인'},{id:'item-support',label:'미제공 상품의 개발자 문의 자료 준비'}]},
 safety:{intro:'모르는 청구를 발견했다면 청구 문구와 주문부터 대조하세요. 기존 청구를 확인하는 일과 앞으로의 구매 인증·계정 접근을 보호하는 일을 함께 진행하되 각각의 결과를 기록합니다.',steps:[{id:'unknown-charges',label:'본인·가족 구매와 미승인 청구 구분'},{id:'account-protection',label:'비밀번호·인증 정보와 구매 설정 보호'}]}
};
const route=routes[topic.id];
const description=`${topic.description} ${route.steps.map(s=>s.label).join(', ')}하는 주제별 안내입니다.`;
---
<Base title={`${topic.name} 가이드`} description={description} crumbs={[{name:'주제별 보기',url:'/topics/'},{name:topic.name,url:`/topics/${topic.id}/`}]}><div class="page-intro"><p class="eyebrow">TOPIC {topic.number}</p><h1>{topic.name}</h1><p>{route.intro}</p></div><section aria-labelledby="start"><h2 id="start">상황에 맞는 확인 순서</h2><ol>{route.steps.filter(s=>articles.some(a=>a.id===s.id)).map(s=><li><a href={`/articles/${s.id}/`}>{s.label}</a></li>)}</ol><p>공식 자료와 적용 범위는 각 글에서 확인할 수 있습니다. 외부 상담은 공식 고객지원과 구분합니다.</p></section><nav class="hub-nav" aria-label="다른 주제">{topics.map(t=><a href={`/topics/${t.id}/`} aria-current={t.id===topic.id?'page':undefined}>{t.name}</a>)}</nav><section aria-labelledby="topic-articles"><h2 id="topic-articles">{topic.name} 상세 글</h2><div class="articles-grid">{articles.map(article=><ArticleCard article={article}/>)}</div></section><p style="margin-top:2rem"><a href="/guide/">← 핵심 가이드로 돌아가기</a></p></Base>
